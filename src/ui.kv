#:kivy 2.3.1

<ISAButton@Button>:
    font_size: "16sp"
    bold: True
    background_normal: ""
    background_down: ""
    background_color: (0.86, 0.86, 0.86, 1)
    color: (0.1, 0.1, 0.1, 1)

<TitleLabel@Label>:
    color: (1, 1, 1, 1)
    bold: True
    font_size: "18sp"

<PanelTitle@Label>:
    bold: True
    font_size: "16sp"
    color: (0.17, 0.17, 0.17, 1)

<HeaderBar@BoxLayout>:
    orientation: "horizontal"
    size_hint_y: None
    height: 56
    padding: 10
    spacing: 8
    canvas.before:
        Color:
            rgba: (0.24, 0.24, 0.24, 1)
        Rectangle:
            pos: self.pos
            size: self.size

    ISAButton:
        text: "P&ID"
        size_hint_x: None
        width: 90
        on_release: app.go_to("realtime")
    ISAButton:
        text: "Medições"
        size_hint_x: None
        width: 110
        on_release: app.go_to("medicoes")
    ISAButton:
        text: "Comando"
        size_hint_x: None
        width: 110
        on_release: app.go_to("comandos")
    ISAButton:
        text: "Elétricas"
        size_hint_x: None
        width: 120
        on_release: app.go_to("eletricas")
    ISAButton:
        text: "Gráfico"
        size_hint_x: None
        width: 100
        on_release: app.go_to("trends")
    ISAButton:
        text: "BD"
        size_hint_x: None
        width: 70
        on_release: app.go_to("history")

    TitleLabel:
        text: "SUPERVISÓRIO – COMPRESSOR DE AR"
        size_hint_x: 1

    ISAButton:
        text: "Conexão"
        size_hint_x: None
        width: 120
        on_release: app.open_connection_popup()

    ISAButton:
        text: "Conectar" if not app.is_online else "Desconectar"
        size_hint_x: None
        width: 150
        on_release: app.toggle_connection()

    Label:
        text: "ONLINE" if app.is_online else "OFFLINE"
        bold: True
        color: (1, 1, 1, 1)
        size_hint_x: None
        width: 120
        canvas.before:
            Color:
                rgba: (0.12, 0.62, 0.22, 1) if app.is_online else (0.31, 0.31, 0.31, 1)
            RoundedRectangle:
                pos: self.pos
                size: self.size
                radius: [12]

<LinearIndicator>:
    orientation: "vertical"
    size_hint: None, None
    size: (240, 140)
    padding: 8
    spacing: 4
    canvas.before:
        Color:
            rgba: (0.97, 0.97, 0.97, 1)
        RoundedRectangle:
            pos: self.pos
            size: self.size
            radius: [12]
        Color:
            rgba: (0.62, 0.62, 0.62, 1)
        Line:
            rounded_rectangle: (self.x, self.y, self.width, self.height, 12)
            width: 1.2

    Label:
        text: root.title
        halign: "center"
        valign: "middle"
        text_size: self.size
        bold: True
        color: (0.12, 0.12, 0.12, 1)

    ProgressBar:
        id: pb
        max: 100
        value: 0
        size_hint_y: None
        height: 14

    Label:
        text: f"{root.value:.2f}"
        font_size: "18sp"
        bold: True
        color: (0.12, 0.12, 0.12, 1)

    Label:
        text: root.unit
        color: (0.25, 0.25, 0.25, 1)

    Label:
        text: f"{root.vmin:g} — {root.vmax:g}"
        font_size: "12sp"
        color: (0.35, 0.35, 0.35, 1)

<ValveStatus>:
    orientation: "horizontal"
    size_hint_y: None
    height: 56
    padding: 8
    spacing: 8
    canvas.before:
        Color:
            rgba: (0.97, 0.97, 0.97, 1)
        RoundedRectangle:
            pos: self.pos
            size: self.size
            radius: [12]
        Color:
            rgba: (0.62, 0.62, 0.62, 1)
        Line:
            rounded_rectangle: (self.x, self.y, self.width, self.height, 12)
            width: 1.2

    Label:
        text: root.name
        bold: True
        size_hint_x: 0.22
        color: (0.12, 0.12, 0.12, 1)

    Label:
        text: "ABERTA" if root.is_open else "FECHADA"
        bold: True
        size_hint_x: 0.18
        color: (1, 1, 1, 1)
        canvas.before:
            Color:
                rgba: (0.12, 0.62, 0.22, 1) if root.is_open else (0.31, 0.31, 0.31, 1)
            RoundedRectangle:
                pos: self.pos
                size: self.size
                radius: [10]

    ISAButton:
        text: "ABRIR"
        size_hint_x: 0.15
        on_release: app.actuate_valve(root.tag, True)

    ISAButton:
        text: "FECHAR"
        size_hint_x: 0.15
        on_release: app.actuate_valve(root.tag, False)

    Label:
        text: root.tag
        size_hint_x: 0.25
        color: (0.25, 0.25, 0.25, 1)

<RealTimeScreen>:
    BoxLayout:
        orientation: "vertical"
        canvas.before:
            Color:
                rgba: (0.93, 0.93, 0.93, 1)
            Rectangle:
                pos: self.pos
                size: self.size
        HeaderBar:
        Image:
            source: "assets/planta.png"
            allow_stretch: True
            keep_ratio: True

<MeasurementsScreen>:
    BoxLayout:
        orientation: "vertical"
        canvas.before:
            Color:
                rgba: (0.93, 0.93, 0.93, 1)
            Rectangle:
                pos: self.pos
                size: self.size
        HeaderBar:
        BoxLayout:
            padding: 10
            spacing: 10
            canvas.before:
                Color:
                    rgba: (0.97, 0.97, 0.97, 1)
                RoundedRectangle:
                    pos: self.pos
                    size: self.size
                    radius: [12]
                Color:
                    rgba: (0.62, 0.62, 0.62, 1)
                Line:
                    rounded_rectangle: (self.x, self.y, self.width, self.height, 12)
                    width: 1.2
            BoxLayout:
                orientation: "vertical"
                padding: 8
                spacing: 8
                PanelTitle:
                    text: "Medições – Processo"
                    size_hint_y: None
                    height: 28
                ScrollView:
                    do_scroll_x: False
                    GridLayout:
                        id: grid_proc
                        cols: 3
                        spacing: 8
                        padding: 4
                        size_hint_y: None
                        height: self.minimum_height

<CommandsScreen>:
    BoxLayout:
        orientation: "vertical"
        canvas.before:
            Color:
                rgba: (0.93, 0.93, 0.93, 1)
            Rectangle:
                pos: self.pos
                size: self.size
        HeaderBar:
        BoxLayout:
            padding: 10
            spacing: 10
            canvas.before:
                Color:
                    rgba: (0.97, 0.97, 0.97, 1)
                RoundedRectangle:
                    pos: self.pos
                    size: self.size
                    radius: [12]
                Color:
                    rgba: (0.62, 0.62, 0.62, 1)
                Line:
                    rounded_rectangle: (self.x, self.y, self.width, self.height, 12)
                    width: 1.2
            BoxLayout:
                orientation: "vertical"
                padding: 8
                spacing: 10
                PanelTitle:
                    text: "Comando – Atuação (somente IG)"
                    size_hint_y: None
                    height: 28
                ISAButton:
                    text: "LIGAR MOTOR"
                    on_release: app.actuate_motor(True)
                ISAButton:
                    text: "DESLIGAR MOTOR"
                    on_release: app.actuate_motor(False)
                BoxLayout:
                    size_hint_y: None
                    height: 44
                    spacing: 8
                    Label:
                        text: "Partida:"
                        size_hint_x: None
                        width: 90
                        color: (0.15, 0.15, 0.15, 1)
                        bold: True
                    Spinner:
                        id: sp_partida
                        text: "Direta"
                        values: ["Direta", "Estrela-Triângulo", "Soft-Starter", "Inversor (VFD)"]
                        size_hint_x: 1
                        background_normal: ""
                        background_color: (0.95, 0.95, 0.95, 1)
                        color: (0.1, 0.1, 0.1, 1)
                    ISAButton:
                        text: "Aplicar"
                        size_hint_x: None
                        width: 110
                        on_release: app.set_start_method(sp_partida.text)
                BoxLayout:
                    orientation: "vertical"
                    size_hint_y: None
                    height: 110
                    spacing: 6
                    BoxLayout:
                        size_hint_y: None
                        height: 28
                        Label:
                            text: "Velocidade (SP):"
                            color: (0.15, 0.15, 0.15, 1)
                            bold: True
                            halign: "left"
                            valign: "middle"
                            text_size: self.size
                        Label:
                            id: lbl_sp_vel
                            text: f"{int(sl_sp_vel.value)} RPM"
                            size_hint_x: None
                            width: 120
                            color: (0.15, 0.15, 0.15, 1)
                            bold: True
                    Slider:
                        id: sl_sp_vel
                        min: 0
                        max: 3600
                        value: 1800
                        step: 10
                        on_value: lbl_sp_vel.text = f"{int(self.value)} RPM"
                    BoxLayout:
                        size_hint_y: None
                        height: 36
                        spacing: 8
                        TextInput:
                            id: ti_sp_vel
                            text: "1800"
                            multiline: False
                            input_filter: "int"
                            hint_text: "RPM"
                            background_normal: ""
                            background_color: (0.95, 0.95, 0.95, 1)
                            foreground_color: (0.1, 0.1, 0.1, 1)
                        ISAButton:
                            text: "Enviar SP"
                            size_hint_x: None
                            width: 140
                            on_release:
                                app.set_speed_setpoint(ti_sp_vel.text)
                                sl_sp_vel.value = int(ti_sp_vel.text) if ti_sp_vel.text.isdigit() else sl_sp_vel.value
                PanelTitle:
                    text: "Válvulas (4 unidades)"
                    size_hint_y: None
                    height: 28
                ScrollView:
                    do_scroll_x: False
                    BoxLayout:
                        id: box_valves
                        orientation: "vertical"
                        size_hint_y: None
                        height: self.minimum_height
                        spacing: 6

<ElectricalScreen>:
    BoxLayout:
        orientation: "vertical"
        canvas.before:
            Color:
                rgba: (0.93, 0.93, 0.93, 1)
            Rectangle:
                pos: self.pos
                size: self.size
        HeaderBar:
        BoxLayout:
            padding: 10
            spacing: 10
            canvas.before:
                Color:
                    rgba: (0.97, 0.97, 0.97, 1)
                RoundedRectangle:
                    pos: self.pos
                    size: self.size
                    radius: [12]
                Color:
                    rgba: (0.62, 0.62, 0.62, 1)
                Line:
                    rounded_rectangle: (self.x, self.y, self.width, self.height, 12)
                    width: 1.2
            BoxLayout:
                orientation: "vertical"
                padding: 8
                spacing: 8
                PanelTitle:
                    text: "Grandezas Elétricas"
                    size_hint_y: None
                    height: 28
                ScrollView:
                    do_scroll_x: False
                    BoxLayout:
                        id: box_el
                        orientation: "vertical"
                        size_hint_y: None
                        height: self.minimum_height
                        spacing: 8

<TrendsScreen>:
    BoxLayout:
        orientation: "vertical"
        canvas.before:
            Color:
                rgba: (0.93, 0.93, 0.93, 1)
            Rectangle:
                pos: self.pos
                size: self.size
        HeaderBar:
        BoxLayout:
            orientation: "vertical"
            padding: 20
            spacing: 10
            PanelTitle:
                text: "Gráfico – Monitoramento em tempo real"
                size_hint_y: None
                height: 30
            BoxLayout:
                padding: 10
                canvas.before:
                    Color:
                        rgba: (1, 1, 1, 1)
                    Rectangle:
                        pos: self.pos
                        size: self.size
                Label:
                    text: "Área para gráficos\n\nVariáveis:\n- co.press_reservatorio\n- co.vazao\n- co.temp_carcaca\n- co.vel_saida_ar"
                    halign: "center"
                    valign: "middle"
                    text_size: self.size
                    color: (0.3, 0.3, 0.3, 1)
                    font_size: "16sp"

<HistoryScreen>:
    BoxLayout:
        orientation: "vertical"
        canvas.before:
            Color:
                rgba: (0.93, 0.93, 0.93, 1)
            Rectangle:
                pos: self.pos
                size: self.size
        HeaderBar:
        BoxLayout:
            orientation: "vertical"
            padding: 20
            spacing: 15
            PanelTitle:
                text: "BD – Busca de Dados Históricos"
                size_hint_y: None
                height: 30
            BoxLayout:
                size_hint_y: None
                height: 100
                padding: 10
                spacing: 10
                canvas.before:
                    Color:
                        rgba: (0.97, 0.97, 0.97, 1)
                    RoundedRectangle:
                        pos: self.pos
                        size: self.size
                        radius: [8]
                BoxLayout:
                    orientation: "vertical"
                    size_hint_x: 0.3
                    spacing: 5
                    Label:
                        text: "Variável:"
                        size_hint_y: None
                        height: 25
                    Spinner:
                        text: "co.press_reservatorio"
                        values: ["co.press_reservatorio", "co.vazao", "co.temp_carcaca", "co.vel_saida_ar", "co.torque", "co.press_tubo_azul"]
                BoxLayout:
                    orientation: "vertical"
                    size_hint_x: 0.3
                    spacing: 5
                    Label:
                        text: "Data Início:"
                        size_hint_y: None
                        height: 25
                    TextInput:
                        text: "2024-01-01 00:00"
                        hint_text: "AAAA-MM-DD HH:MM"
                BoxLayout:
                    orientation: "vertical"
                    size_hint_x: 0.3
                    spacing: 5
                    Label:
                        text: "Data Fim:"
                        size_hint_y: None
                        height: 25
                    TextInput:
                        text: "2024-01-01 23:59"
                        hint_text: "AAAA-MM-DD HH:MM"
                ISAButton:
                    text: "BUSCAR"
                    size_hint_x: 0.1
                    on_release: print("Buscar dados históricos (somente IG)")
            BoxLayout:
                padding: 10
                canvas.before:
                    Color:
                        rgba: (1, 1, 1, 1)
                    Rectangle:
                        pos: self.pos
                        size: self.size
                Label:
                    text: "Resultados aparecerão aqui (tabela/gráfico).\n\nIntegração ORM/BD será do backend."
                    halign: "center"
                    valign: "middle"
                    text_size: self.size
                    color: (0.3, 0.3, 0.3, 1)
                    font_size: "16sp"
